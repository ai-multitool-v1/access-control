<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header: brand + connection status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_clay_card"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/clay_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dashStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/dot_offline" />

                <TextView
                    android:id="@+id/dashStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/dash_connecting"
                    android:textColor="@color/clay_text_soft"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <LinearLayout style="@style/DashCard">
                    <TextView style="@style/DashCardLabel" android:text="Screen Time" />
                    <TextView android:id="@+id/dashScreenTime" style="@style/DashCardValue" android:text="@string/dash_unknown" />
                </LinearLayout>

                <LinearLayout style="@style/DashCard">
                    <TextView style="@style/DashCardLabel" android:text="Device" />
                    <TextView android:id="@+id/dashDevice" style="@style/DashCardValue" android:text="@string/dash_unknown" />
                </LinearLayout>

                <LinearLayout style="@style/DashCard">
                    <TextView style="@style/DashCardLabel" android:text="Battery" />
                    <TextView android:id="@+id/dashBattery" style="@style/DashCardValue" android:text="@string/dash_unknown" />
                </LinearLayout>

                <LinearLayout style="@style/DashCard">
                    <TextView style="@style/DashCardLabel" android:text="App Usage" />
                    <TextView android:id="@+id/dashUsageAccess" style="@style/DashCardValue" android:text="@string/dash_unknown" />
                </LinearLayout>

                <LinearLayout style="@style/DashCard">
                    <TextView style="@style/DashCardLabel" android:text="Location" />
                    <TextView android:id="@+id/dashLocation" style="@style/DashCardValue" android:text="@string/dash_unknown" />
                </LinearLayout>

                <LinearLayout style="@style/DashCard">
                    <TextView style="@style/DashCardLabel" android:text="Protection" />
                    <TextView android:id="@+id/dashProtection" style="@style/DashCardValue" android:text="@string/dash_unknown" />
                </LinearLayout>
            </GridLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_button_soft"
                android:text="@string/dash_open_permissions"
                android:textColor="@color/clay_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTelegramSupport"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_clay_button_soft"
            android:text="@string/dash_telegram_support"
            android:textColor="@color/clay_primary"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_clay_button_primary"
            android:text="@string/dash_settings"
            android:textColor="#062A22"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
