<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permissions &amp; Device Setup"
        android:textColor="@color/clay_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Each permission is used only for the features explained on its card. Grant what you agree with — optional rows can be skipped."
        android:textColor="@color/clay_text_soft"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Accessibility — instant app block / screen time / instant block -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_accessibility" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Accessibility — instant app blocking" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Makes app blocking, screen-time limits and instant block act immediately when a restricted app opens." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permAccessibilityStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permAccessibilityBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Notification Access -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_notif_monitor" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Notification access — monitor notifications" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Lets the parent dashboard see notifications from social apps (Facebook, Instagram, WhatsApp…) when monitoring is enabled." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permNotifListenerStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permNotifListenerBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Location precise -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_location" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Location (precise)" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Only used when your parent enables location monitoring. Status is visible on your dashboard." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permLocationStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permLocationBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Location all the time -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_location_bg" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Location — allow all the time" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Enables route history and geofence alerts while the screen is off. Choose &quot;Allow all the time&quot; in the dialog." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permLocationBgStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permLocationBgBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Usage Access -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_usage" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Usage access — screen time &amp; app usage" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Required for installed apps list, screen-time reports and app limits to work." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permUsageStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permUsageBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Display over other apps -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_overlay" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Display over other apps" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Shows a friendly &quot;time is up&quot; screen when a limit is reached, and tap-to-allow prompts for remote features." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permOverlayStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permOverlayBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 7. Battery unrestricted -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_battery" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Battery — unrestricted background" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Keeps the connection alive. Some phones (Xiaomi, Huawei, Samsung) also need &quot;Auto-start&quot; enabled in their own settings." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permBatteryStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permBatteryBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 8. Microphone -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_mic" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Microphone — one-way audio" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Used only when your parent starts remote audio. While active, a notification and the Android mic indicator are always shown." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permMicStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permMicBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 9. Camera -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_camera" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Camera — remote camera &amp; mirroring" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Used only when your parent starts remote camera. While active, a notification and the Android camera indicator are always shown." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permCameraStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permCameraBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 10. Notifications -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_bell" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Notifications" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Shows parent messages, protection status and remote-access prompts." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permNotifStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permNotifBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 11. Contacts / Phone / SMS (optional) -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_contacts" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Contacts / Phone / SMS (optional)" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Optional call &amp; SMS monitoring — the parent can view recent calls, messages and safety contacts. Skip if you don\'t want it." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permCommsStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permCommsBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 12. Storage / Photos -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_storage" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Storage / Photos" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Needed for file and media related features." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permStorageStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permStorageBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 13. Install unknown apps -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_install" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Install unknown apps" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Allows the protection wizard to install app updates without reinstalling from scratch." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permInstallStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permInstallBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- 14. Device admin (optional) -->
            <LinearLayout style="@style/PermCard" android:foreground="?attr/selectableItemBackground">
                <LinearLayout style="@style/PermHeader">
                    <ImageView style="@style/PermIcon" android:src="@drawable/ic_perm_admin" android:contentDescription="@null" />
                    <TextView style="@style/PermTitle" android:text="Uninstall protection (Device admin, optional)" />
                </LinearLayout>
                <TextView style="@style/PermDesc" android:text="Enables screen lock during bedtime/school mode and makes uninstalling a deliberate step. The parent can approve a short uninstall window remotely." />
                <LinearLayout style="@style/PermRow">
                    <TextView android:id="@+id/permAdminStatus" style="@style/PermStatus" />
                    <Button android:id="@+id/permAdminBtn" style="@style/PermButton" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_clay_button_primary"
        android:elevation="8dp"
        android:text="@string/perm_continue"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
