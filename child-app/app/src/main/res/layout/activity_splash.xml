<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050807"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_logo"
        android:tint="#00FFC8" />

    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:alpha="0"
        android:letterSpacing="0.22"
        android:text="@string/app_name"
        android:textColor="#00FFC8"
        android:fontFamily="monospace"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0"
        android:letterSpacing="0.14"
        android:text="@string/splash_tagline"
        android:textColor="#39FF91"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/splashCreditBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:background="@drawable/bg_cyber_outline"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="16dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/splashCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/splash_developer"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashCreditSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/developer_subtitle"
            android:textColor="#00FFC8"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/btnTelegram"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_cyber_outline"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/dash_telegram_support"
                android:src="@drawable/ic_tg"
                android:tint="#00FFC8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="@string/dash_telegram_support"
                android:textColor="#00FFC8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/splashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="monospace"
        android:textColor="#2E7D63"
        android:textSize="11sp" />
</LinearLayout>
