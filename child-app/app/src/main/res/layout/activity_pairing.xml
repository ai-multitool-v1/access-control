<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pairing_title"
        android:textColor="@color/clay_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/pairing_hint"
        android:textColor="@color/clay_text_soft"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/pairingInput"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_clay_card"
        android:elevation="6dp"
        android:gravity="center"
        android:hint="7K4P-92XM"
        android:inputType="textCapCharacters"
        android:letterSpacing="0.2"
        android:maxLength="9"
        android:textColor="@color/clay_text"
        android:textColorHint="#C4BCE8"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pairingProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="18dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pairingError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/clay_red"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pairingSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/pairing_success"
        android:textColor="@color/clay_green"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_clay_button_primary"
        android:elevation="8dp"
        android:text="@string/pairing_connect"
        android:textColor="#062A22"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
