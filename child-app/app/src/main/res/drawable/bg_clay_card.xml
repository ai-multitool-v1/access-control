<?xml version="1.0" encoding="utf-8"?>
<!-- Cyber card: deep space panel + hard neon-tinted stroke (dashboard spatial-card) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#66000000" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#131822"
                android:endColor="#0B0E13" />
            <stroke
                android:width="2dp"
                android:color="@color/clay_stroke" />
        </shape>
    </item>
</layer-list>
