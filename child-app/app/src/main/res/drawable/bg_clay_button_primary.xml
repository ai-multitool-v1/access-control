<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button: solid neon with hard offset shadow base (dashboard btn-primary) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/clay_primary" />
            <stroke android:width="1dp" android:color="@color/clay_primary" />
        </shape>
    </item>
</layer-list>
