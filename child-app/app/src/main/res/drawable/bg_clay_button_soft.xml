<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost button: dark panel, neon text on press-ready surface (dashboard btn-ghost) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#80000000" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#171C26"
                android:endColor="#11151D" />
            <stroke
                android:width="2dp"
                android:color="@color/clay_stroke" />
        </shape>
    </item>
</layer-list>
