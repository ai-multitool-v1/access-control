<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050807" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="200dp" android:height="200dp" />
            <stroke android:width="1dp" android:color="#3300FFC8" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="260dp" android:height="260dp" />
            <stroke android:width="1dp" android:color="#1A00FFC8" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="320dp" android:height="320dp" />
            <stroke android:width="1dp" android:color="#0D00FFC8" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
