# PUBLIC CONFIG — these values are safe to bundle into the frontend.
# Copy this file to .env for local dev, or set them in Cloudflare Pages → Settings → Environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_BASE=https://access-control-api.YOUR-SUBDOMAIN.workers.dev
VITE_WS_BASE=wss://access-control-api.YOUR-SUBDOMAIN.workers.dev

# SERVER SECRETS (never set these here — they live only in the Worker):
